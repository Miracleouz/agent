# Node.js 24+. O primeiro acesso cria a conta do dono no próprio painel.
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
# Defina uma URL HTTPS pública ao hospedar. Ativa cookie seguro e verificação de origem.
# APP_URL=https://seu-dominio.com
# Caminho para Chromium/Chrome instalado. O sistema tenta detectar automaticamente.
# CHROME_PATH=/usr/bin/chromium
# Opcional: restaura a conexão autorizada por QR quando o servidor reiniciar.
WHATSAPP_AUTO_CONNECT=false
# Tempo para o WhatsApp carregar no Chromium: 30000 a 300000 ms. Padrão: 90000.
WHATSAPP_AUTH_TIMEOUT_MS=90000

# Interpretar áudios novos/não lidos de clientes com o modelo local de voz.
BOT_AUDIO_ENABLED=true
# Transcrever também áudios novos recebidos durante atendimento manual (sem resposta).
AUTO_TRANSCRIBE=false
